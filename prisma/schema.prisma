generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String         @id @default(uuid())
  email            String         @unique
  name             String?
  passwordHash     String
  role             String         @default("SALES_REP")
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  projects         Project[]      @relation("ProjectAssignee")
  createdQuotes    QuoteVersion[] @relation("QuoteCreator")
  createdTickets   Ticket[]       @relation("TicketCreator")
  assignedTickets  Ticket[]       @relation("TicketAssignee")
  notifications    Notification[]
}

model Customer {
  id          String    @id @default(uuid())
  name        String
  email       String?
  phone       String?
  tier        String    @default("RETAIL")
  creditLimit Float     @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  projects    Project[]
}

model Project {
  id                String             @id @default(uuid())
  name              String
  customerId        String
  customer          Customer           @relation(fields: [customerId], references: [id])
  assignedToId      String?
  assignedTo        User?              @relation("ProjectAssignee", fields: [assignedToId], references: [id])
  status            String             @default("NEW")
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  dealSpecification DealSpecification?
  quotes            QuoteVersion[]
  milestones        ProjectMilestone[]
  tickets           Ticket[]
}

model DealSpecification {
  id               String   @id @default(uuid())
  projectId        String   @unique
  project          Project  @relation(fields: [projectId], references: [id])
  description      String?
  area             Float?
  glassColor       String?
  glassThickness   Float?
  hardware         String?
  installationType String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model QuoteVersion {
  id          String   @id @default(uuid())
  projectId   String
  project     Project  @relation(fields: [projectId], references: [id])
  version     Int      @default(1)
  status      String   @default("DRAFT")
  totalAmount Float    @default(0)
  details     String?
  createdById String
  createdBy   User     @relation("QuoteCreator", fields: [createdById], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ProjectMilestone {
  id         String    @id @default(uuid())
  projectId  String
  project    Project   @relation(fields: [projectId], references: [id])
  phase      String
  percentage Float
  amount     Float
  dueDate    DateTime?
  isPaid     Boolean   @default(false)
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
}

model Ticket {
  id             String   @id @default(uuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  errorType      String
  responsibility String
  resolution     String
  status         String   @default("OPEN")
  description    String?
  createdById    String
  createdBy      User     @relation("TicketCreator", fields: [createdById], references: [id])
  assignedToId   String?
  assignedTo     User?    @relation("TicketAssignee", fields: [assignedToId], references: [id])
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model PricingConfig {
  id          String   @id @default(uuid())
  productType String
  thickness   Float
  pricePerSqM Float
  unit        String   @default("m2")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model WebhookConfig {
  id        String   @id @default(uuid())
  url       String
  eventType String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
